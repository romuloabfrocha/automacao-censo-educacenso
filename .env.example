# Copie este arquivo para ".env" e preencha com os seus dados.
# O .env NUNCA deve ser commitado (já está no .gitignore).

# CPF e senha de acesso ao Educacenso (https://educacenso.inep.gov.br)
CENSO_LOGIN_CPF=
CENSO_LOGIN_SENHA=

# Código INEP da escola
CENSO_CODIGO_ESCOLA=

# Carga horária integralizada informada no formulário de vínculo
CENSO_CARGA_HORARIA=400

# Nome do arquivo da planilha de alunos (veja MODELO_PLANILHA.xlsx)
CENSO_PLANILHA=DADOSCENSO2026.xlsx
